# Starman Integration Test Configuration
# Copy this file to .env and fill in your real credentials
#   cp .env.example .env

# GitHub personal access token (required for integration tests)
# Create at: https://github.com/settings/tokens
# Scopes needed: read:user, user:email (for listing starred repos)
GITHUB_TOKEN=

# Your GitHub username (required for listing starred repos)
GITHUB_USERNAME=

# AI / OpenAI-compatible API (optional, for ai package integration tests)
STARMAN_AI_API_KEY=
STARMAN_AI_BASE_URL=
STARMAN_AI_MODEL=
