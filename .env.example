# Starman Integration Test Configuration
# Copy this file to .env and fill in your real credentials
#   cp .env.example .env

# GitHub personal access token (required for integration tests)
# Create at: https://github.com/settings/tokens
# Scopes needed: read:user, user:email (for listing starred repos)
GITHUB_TOKEN=

# Your GitHub username (required for listing starred repos)
GITHUB_USERNAME=

# Optional: target owner/repo for release incremental sync tests
# e.g. GITHUB_TEST_OWNER=kubernetes GITHUB_TEST_REPO=kubernetes
GITHUB_TEST_OWNER=
GITHUB_TEST_REPO=

# AI / OpenAI-compatible API (optional, for ai package integration tests)
STARMAN_AI_API_KEY=
STARMAN_AI_BASE_URL=
STARMAN_AI_MODEL=

# Embedding / OpenAI-compatible embedding API (optional, for embedding integration tests)
# If STARMAN_EMBEDDING_API_KEY is set, it overrides STARMAN_AI_API_KEY for embedding
STARMAN_EMBEDDING_API_KEY=
STARMAN_EMBEDDING_BASE_URL=
STARMAN_EMBEDDING_MODEL=
